CINEPLEX_APIM_SUBSCRIPTION_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional persistent local background service (disabled unless explicitly set)
# WATCH_BACKEND=local
# WATCH_MODE=fixture
# WATCH_DB_PATH=.watch-data/watches.sqlite
# AWS backend uses server-side default AWS credentials; never NEXT_PUBLIC_ credentials.
# WATCH_BACKEND=aws
# WATCH_TABLE=
# WATCH_QUEUE_URL=
# WATCH_DLQ_URL=


# Vercel production: private, scoped IAM service key; AWS calls pinned to Ohio.
# WATCH_BACKEND=aws
# WATCH_MODE=live
# WATCH_DEPLOYMENT=production
# WATCH_AWS_REGION=us-east-2
# WATCH_AWS_AUTH=service-key
# WATCH_AWS_ACCESS_KEY_ID= (Vercel Secret; never NEXT_PUBLIC_)
# WATCH_AWS_SECRET_ACCESS_KEY= (Vercel Secret; never commit or log)
# WATCH_MAX_ACTIVE=3
# WATCH_MAX_REGISTRATIONS=6
# WATCH_POLLING_END_DATE= (same approved ISO UTC end as CDK)
# WATCH_TABLE= (existing stack output)
# WATCH_QUEUE_URL= (existing stack output)
# WATCH_DLQ_URL= (existing stack output; web credential cannot send here)
# Lambda uses execution roles. Do not copy CLI session tokens into Vercel.
